{
  "scripts": {
    "start": "webpack serve --mode development --host 0.0.0.0",
    "build": "webpack --mode production",
    "test": "jest",
    "prettier": "prettier -c --write ./src/**/*"
  },
  "author": "Danakt Saushkin <danakt@danakt.com>",
  "license": "MIT",
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": ["ts-jest", { "tsconfig": "tsconfig.json" }]
    },
    "testMatch": [
      "**/__tests__/**/*.ts?(x)",
      "**/?(*.)+(spec|test).ts?(x)"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "lib/**/*.ts"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@types/jest": "^30.0.0",
    "@types/jest-image-snapshot": "^4.3.1",
    "@types/node": "^17.0.13",
    "@types/ramda": "^0.27.64",
    "@types/react": "^17.0.38",
    "@types/react-color": "^3.0.6",
    "@types/react-dom": "^17.0.11",
    "@types/react-dropzone": "^5.1.0",
    "@types/react-hot-loader": "^4.1.1",
    "@types/styled-components": "^5.1.21",
    "@types/three": "^0.185.4",
    "babel-plugin-styled-components": "^2.0.2",
    "fast-dataview": "^0.3.3",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.0",
    "jest": "^30.4.2",
    "jest-image-snapshot": "^4.5.1",
    "prettier": "^2.5.1",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.2.6",
    "ts-node": "^10.4.0",
    "typescript": "^5.9.3",
    "webpack": "^5.104.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.6"
  },
  "dependencies": {
    "fast-png": "^6.1.0",
    "gl-matrix": "^3.4.3",
    "libreact": "^2.13.3",
    "multi-array-view": "^0.1.7",
    "ramda": "^0.28.0",
    "react": "^17.0.2",
    "react-color": "^2.19.3",
    "react-dom": "^17.0.2",
    "react-dropzone": "^11.5.1",
    "react-hot-loader": "^4.13.0",
    "style-loader": "^3.3.1",
    "styled-components": "^5.3.3",
    "three": "^0.185.1"
  }
}
